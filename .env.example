# Required: Coda API token (https://coda.io/account#apiSettings)
# Also accepted, in this order: CODA_API_TOKEN, CODA_TOKEN, CODA_PAT — first non-empty wins.
CODA_API_TOKEN=

# Optional: Lock the server read-only. Write tools and write-workflow prompts are
# not listed and are refused before any API call. Any value other than
# false/0/no/off/empty locks; nothing turns it back off at runtime.
# MCP_READ_ONLY (same switch, shared across the mcp-* servers) is honoured too.
# CODA_READ_ONLY=false

# Optional: Custom API base URL
# CODA_BASE_URL=https://coda.io/apis/v1

# Optional: HTTP timeout in seconds
# CODA_TIMEOUT=30

# Optional: SSL certificate verification
# CODA_SSL_VERIFY=true
